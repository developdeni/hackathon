# Copernicus Data Space Ecosystem / Sentinel Hub OAuth credentials
# Получить бесплатно: https://dataspace.copernicus.eu/
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# Telegram Mini App and bot. Generate a fresh token in BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=tanapai_aqmola_bot
MINI_APP_URL=https://your-public-host.example/tma/

# Google Gemini for AI agronomist and vision modules. Keep real keys out of git.
GEMINI_API_KEY=
# Optional comma-separated key pool; backend tries keys in order when quotas fail.
GEMINI_API_KEYS=

# Почта-отправитель: коды подтверждения email и уведомления.
# Берётся ПЕРВЫЙ настроенный провайдер. Если не заполнить ничего — сайт работает
# как обычно, письма не уходят, а код возвращается в приложение (devCode) для демо.
MAIL_FROM_NAME=Tanap AI

# Вариант 1 (РЕКОМЕНДУЕТСЯ): Brevo — бесплатно ~300 писем/день, на любые адреса,
# домен НЕ нужен. Регистрация: https://www.brevo.com → подтвердить e-mail
# отправителя (Senders) → ключ в Settings → SMTP & API → API Keys.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# Вариант 2: Resend — https://resend.com (вход через GitHub, ключ сразу).
# Через onboarding@resend.dev письма идут ТОЛЬКО на твой e-mail; на любые адреса
# нужен подтверждённый домен и тогда RESEND_FROM="Tanap AI <no-reply@твойдомен>".
RESEND_API_KEY=
RESEND_FROM=

# Вариант 3: обычный SMTP (например Gmail App Password — не обычный пароль!).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Настройки окружения
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
JWT_SECRET=tanap-ai-local-development-only
